rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.uid == '9wcNWi3Fq7SoDxo4lXS92dUm7s43' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // 1. Users collection: Users can read/write their own document (without privilege escalation); Admins can list and read all
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId &&
        !request.resource.data.keys().hasAny(['role', 'isAdmin', 'permissions', 'admin', 'serviceCredentials', 'subscriptionAuthority', 'quota']);
      allow update: if isSignedIn() && isValidId(userId) && (
        (request.auth.uid == userId &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'permissions', 'admin', 'serviceCredentials', 'subscriptionAuthority', 'quota'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 2. Admins collection: Checked for RBAC, only admins can modify
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 3. Daily aggregated operational stats
    match /daily_stats/{date} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(date);
      allow delete: if isAdmin();
    }

    // 4. Autonomous Worker & System Persistent State (Server-owned & Admin Only)
    match /autonomous_state/{stateId} {
      allow read, write: if isAdmin();
    }

    // 5. Autonomous Ticks Log (Server-owned)
    match /ticks/{tickId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 6. System Audit Logs (Append-only / Server-owned)
    match /audit_logs/{auditId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // 7. Conversations collection: Users can only access their own conversations
    match /conversations/{conversationId} {
      allow get, list: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidId(conversationId);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidId(conversationId);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 8. Memories collection: Users can only access their own memories
    match /memories/{memoryId} {
      allow get, list: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidId(memoryId);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidId(memoryId);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
