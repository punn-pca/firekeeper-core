rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all for unknown collections
    match /{document=**} {
      allow read, write: if true;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.uid == '9wcNWi3Fq7SoDxo4lXS92dUm7s43' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // 1. Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. Admins collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // 3. Daily aggregated operational stats
    match /daily_stats/{date} {
      allow read, write: if true;
    }

    // 4. Autonomous Worker & System Persistent State
    match /autonomous_state/{stateId} {
      allow read, write: if true;
    }

    // 5. X Posts & Sync
    match /x_posts/{postId} {
      allow read, write: if true;
    }

    // 6. X OAuth States & PKCE
    match /x_oauth_states/{stateId} {
      allow read, write: if true;
    }

    // 7. X Connections
    match /x_connections/{connectionId} {
      allow read, write: if true;
    }

    // 8. Autonomous Ticks Log
    match /ticks/{tickId} {
      allow read, write: if true;
    }

    // 9. System Audit Logs
    match /audit_logs/{auditId} {
      allow read, write: if true;
    }

    // 10. Audit Jobs
    match /audit_jobs/{jobId} {
      allow read, write: if true;
    }

    // 11. Conversations collection
    match /conversations/{conversationId} {
      allow read, write: if true;
    }

    // 12. Memories collection
    match /memories/{memoryId} {
      allow read, write: if true;
    }

    // 13. Fire Keeper simulated posts
    match /posts/{postId} {
      allow read, write: if true;
    }

    // 14. Fire Keeper simulated events
    match /events/{eventId} {
      allow read, write: if true;
    }

    // 15. Fire Keeper engine logs
    match /engine_logs/{logId} {
      allow read, write: if true;
    }

    // 16. Fire Keeper autonomous events
    match /autonomous_events/{eventId} {
      allow read, write: if true;
    }
  }
}
