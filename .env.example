# DEEPSEEK_API_KEY: Primary AI API key for DeepSeek model execution (deepseek-chat, deepseek-reasoner).
# Runtime Policy: DEEPSEEK_ONLY in src/server/services/ai.ts
DEEPSEEK_API_KEY=""

# GEMINI_API_KEY: Optional/legacy. Automatically managed by AI Studio container platform.
GEMINI_API_KEY=""

# OPENAI_API_KEY: Optional fallback key (currently inactive under DEEPSEEK_ONLY runtime policy).
OPENAI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""

# APP_ORIGIN: Optional explicit CORS origin allowlist (e.g., https://firekeeper.site)
APP_ORIGIN=""

# FIREKEEPER_ADMIN_PASSWORD: Optional admin password for administrative login.
# If not configured, admin login returns HTTP 503 while Guest Mode remains fully functional.
FIREKEEPER_ADMIN_PASSWORD=""

# ADMIN_UID: Optional Firebase UID for admin authorization override
ADMIN_UID=""

# SERVICE_SECRET: Optional secret token for internal service/worker authorization
SERVICE_SECRET=""

# X (Twitter) API v2 Credentials (OAuth 2.0 PKCE or OAuth 1.0a User Context)
# Configured via AI Studio Secrets or environment variables
X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_API_KEY=""
X_API_SECRET=""
X_ACCESS_TOKEN=""
X_ACCESS_SECRET=""

# OFFLINE_ONLY: Set to "true" to bypass Google / Firebase Auth entirely and enable full offline local mode.
OFFLINE_ONLY="false"

# OLLAMA_BASE_URL: Local Ollama daemon URL (default: http://127.0.0.1:11434)
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# OLLAMA_MODEL: Default Ollama model tag (e.g. qwen3:4b, qwen2.5:3b)
OLLAMA_MODEL="qwen3:4b"
