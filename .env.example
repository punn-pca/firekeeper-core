# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional OpenAI API key for OpenAI model selection (gpt-4o, gpt-4o-mini, etc.).
OPENAI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREKEEPER_ADMIN_PASSWORD: Optional admin password for administrative login.
# If not configured, admin login returns HTTP 503 while Guest Mode remains fully functional.
FIREKEEPER_ADMIN_PASSWORD=""

# X (Twitter) API Credentials (OAuth 1.0a User Context or OAuth 2.0 User Token)
# Configured via AI Studio Secrets or environment variables
X_API_KEY="zDwRQGOIaFOztKNPlue14Is8J"
X_API_SECRET="ufNc0Z8yN9yoX8ATqURhFvjp7SKtWSjA0uWSI0hXbAp0xqcARn"
