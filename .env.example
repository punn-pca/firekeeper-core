# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# OPENAI_API_KEY: Optional OpenAI API key for OpenAI model selection (gpt-4o, gpt-4o-mini, etc.).
OPENAI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""

# APP_ORIGIN: Optional explicit CORS origin allowlist (e.g., https://firekeeper.site)
APP_ORIGIN=""

# FIREKEEPER_ADMIN_PASSWORD: Optional admin password for administrative login.
# If not configured, admin login returns HTTP 503 while Guest Mode remains fully functional.
FIREKEEPER_ADMIN_PASSWORD=""

# ADMIN_UID: Optional Firebase UID for admin authorization override
ADMIN_UID=""

# SERVICE_SECRET: Optional secret token for internal service/worker authorization
SERVICE_SECRET=""

# X (Twitter) API v2 Credentials (OAuth 2.0 PKCE or OAuth 1.0a User Context)
# Configured via AI Studio Secrets or environment variables
X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_API_KEY=""
X_API_SECRET=""
X_ACCESS_TOKEN=""
X_ACCESS_SECRET=""



