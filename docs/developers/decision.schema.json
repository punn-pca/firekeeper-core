{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firekeeper.site/developers/schemas/decision-v1.json",
  "title": "FIRE KEEPER Decision Object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "options",
    "risks",
    "uncertainties",
    "consequences",
    "evidence",
    "assumptions",
    "confidence",
    "applicable_policies",
    "policy_conflicts",
    "escalation_required",
    "controlLevel"
  ],
  "properties": {
    "options": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/option"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uncertainty"
      }
    },
    "consequences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/consequence"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendation": {
      "anyOf": [
        {
          "$ref": "#/$defs/recommendation"
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "$ref": "#/$defs/confidence"
    },
    "applicable_policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policy"
      }
    },
    "policy_conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policyConflict"
      }
    },
    "escalation_required": {
      "type": "boolean"
    },
    "controlLevel": {
      "$ref": "#/$defs/severity"
    }
  },
  "$defs": {
    "severity": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "rationale",
        "isRecommended"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "isRecommended": {
          "type": "boolean"
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "severity"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "relatedOptionIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "importance"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "importance": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        }
      }
    },
    "consequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "timeframe": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "sourceId"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "sourceId": {
          "type": "string"
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "optionId",
        "rationale"
      ],
      "properties": {
        "optionId": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "label",
        "breakdown"
      ],
      "properties": {
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "breakdown": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "policyConflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId1",
        "policyId2",
        "severity",
        "rationale"
      ],
      "properties": {
        "policyId1": {
          "type": "string"
        },
        "policyId2": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "rationale": {
          "type": "string"
        }
      }
    }
  }
}
